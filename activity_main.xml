<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:text="Losowanie kostek"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Liczba kostek:"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/LiczbaKostek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Podaj liczbe kostek"
            android:inputType="number"
            android:text="5" />

        <Button
            android:id="@+id/buttonLosuj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="lusuj" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wylosowane kostki:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/Kostki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alignmentMode="alignMargins"
            android:columnCount="1"
            android:gravity="center"
            android:useDefaultMargins="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Wyniki:"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/Wyniki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:text="wyniki"
            android:textSize="20sp" />

        <Button
            android:id="@+id/buttonRosnaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="sortuj rosnaco" />

        <Button
            android:id="@+id/buttonMalejaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="sortuj malejaco" />

    </LinearLayout>
</ScrollView>
